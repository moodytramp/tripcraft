# ===========================================
# TripCraft Environment Variables
# ===========================================
# Copy this file to .env.local and fill in values

# Database
DATABASE_URL=postgresql://tripcraft:tripcraft@localhost:5432/tripcraft

# Redis
REDIS_URL=redis://localhost:6379

# Auth0
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_CLIENT_ID=your-client-id
AUTH0_CLIENT_SECRET=your-client-secret
AUTH0_AUDIENCE=https://api.tripcraft.app

# External APIs
AMADEUS_API_KEY=your-amadeus-key
AMADEUS_API_SECRET=your-amadeus-secret
SHERPA_API_KEY=your-sherpa-key
BOOKING_API_KEY=your-booking-key
OPENWEATHERMAP_API_KEY=your-openweather-key
UNSPLASH_ACCESS_KEY=your-unsplash-key

# AWS (for S3 document storage)
AWS_REGION=eu-west-1
AWS_S3_DOCUMENTS_BUCKET=tripcraft-documents

# App
NODE_ENV=development
PORT=3001
